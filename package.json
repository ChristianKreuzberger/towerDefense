{
  "name": "tower-defense",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run -ws --if-present build",
    "typecheck": "npm run -ws --if-present typecheck",
    "lint": "eslint .",
    "test": "npm run -ws --if-present test",
    "test:perf": "npm --workspace @tower-defense/simulation run test:perf",
    "test:e2e": "playwright test",
    "clean": "npm run -ws --if-present clean",
    "dev:client": "npm --workspace @tower-defense/client run dev",
    "dev:server": "npm --workspace @tower-defense/server run dev",
    "dev:game": "npm run build && npm run dev:server",
    "dev:full": "npm run dev:server",
    "baseline:balance:capture": "npm --workspace @tower-defense/simulation run report:baseline:capture",
    "baseline:balance:report": "npm --workspace @tower-defense/simulation run report:baseline:capture -- --stdout",
    "baseline:balance:diff": "npm --workspace @tower-defense/simulation run report:baseline:diff",
    "baseline:balance:diff:stdout": "npm --workspace @tower-defense/simulation run report:baseline:diff:stdout",
    "baseline:balance:diff:ci": "npm --workspace @tower-defense/simulation run report:baseline:diff:ci",
    "baseline:balance:verify:ci": "npm run build && npm run baseline:balance:diff:ci",
    "baseline:balance:refresh:guard": "./scripts/baseline-balance-refresh-guard.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  }
}
