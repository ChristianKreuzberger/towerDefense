{
  "name": "@tower-defense/transport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./game-api": { "types": "./dist/game-api.d.ts", "default": "./dist/game-api.js" },
    "./http-client": { "types": "./dist/http-client.d.ts", "default": "./dist/http-client.js" }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test dist/*.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tower-defense/shared": "0.1.0",
    "@tower-defense/simulation": "0.1.0"
  }
}
