{
  "name": "@tower-defense/simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./match": { "types": "./dist/match-simulation.d.ts", "default": "./dist/match-simulation.js" },
    "./ai-player": { "types": "./dist/ai-player.d.ts", "default": "./dist/ai-player.js" }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test dist/*.test.js",
    "test:perf": "npm run build && node --test dist/match-simulation.perf.test.js",
    "report:balance": "node dist/balance-report.cli.js",
    "report:balance:help": "node dist/balance-report.cli.js --help",
    "report:baseline:capture": "node dist/baseline-report.cli.js",
    "report:baseline:diff": "node dist/baseline-diff.cli.js",
    "report:baseline:diff:stdout": "node dist/baseline-diff.cli.js --stdout",
    "report:baseline:diff:ci": "node dist/baseline-diff.cli.js --stdout --fail-on-drift true",
    "report:baseline:capture:help": "node dist/baseline-report.cli.js --help",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tower-defense/shared": "0.1.0"
  }
}
